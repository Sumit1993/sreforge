# =============================================================================
# Central Configuration (single source of truth for all apps/services)
# Copy to .env and adjust values as needed: cp .env.example .env
# =============================================================================

NODE_ENV=development

# --- Service Ports ---
API_PORT=3000
UI_PORT=3001

# --- Public API URL (embedded into UI bundle at dev-server start) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# API_PYTHON_PORT=8000
# API_JAVA_PORT=8080
# API_GO_PORT=8081

# --- Database ---
DATABASE_URL=postgresql://todo:todopass@127.0.0.1:5432/tododb

# --- Cache (Valkey — Redis-compatible) ---
REDIS_URL=redis://localhost:6379

# --- Metrics ---
METRICS_PROVIDER=local
LOCAL_PUSHGATEWAY_URL=http://localhost:9091/metrics/job/todo-api

# --- Grafana (optional) ---
# GRAFANA_LOKI_URL=https://logs-prod-xx-xxx.grafana.net/loki/api/v1/push
# GRAFANA_API_KEY=your-grafana-api-key
# GRAFANA_USERNAME=your-grafana-username
# GRAFANA_PASSWORD=your-grafana-password
