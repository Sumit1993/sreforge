# syntax=docker/dockerfile:1
# SREForge node-compose substrate — Todo API image.
#
# IMPORTANT: the build context MUST be the node-compose root (the pnpm
# workspace root), NOT apps/api — the API depends on the workspace package
# @todo-app/core and the Prisma client generated by @todo-app/db. The compose
# file sets `context: ..` accordingly. To build by hand:
#   docker build -f apps/api/Dockerfile -t sreforge/todo-api .
#
# The runtime stage inherits the full build stage (source + node_modules +
# generated Prisma client + dev deps). That keeps v1 reliable and lets the same
# image run the one-shot migrate/seed job. Slimming the runtime image (pnpm
# deploy --prod) is a deferred optimization.

FROM node:20-alpine AS base
# openssl + libc6-compat: Prisma engine needs them on musl. corepack: pnpm.
RUN apk add --no-cache openssl libc6-compat \
 && corepack enable
WORKDIR /app

# ---- deps: install only the API's slice of the workspace (api + core + db) ----
# UI / config packages are NOT installed (skips next/sharp native deps), but
# their manifests are copied so pnpm workspace resolution stays consistent.
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json                    apps/api/
COPY apps/ui/package.json                     apps/ui/
COPY packages/core/package.json               packages/core/
COPY packages/db/package.json                 packages/db/
COPY packages/eslint-config/package.json      packages/eslint-config/
COPY packages/typescript-config/package.json  packages/typescript-config/
RUN pnpm install --frozen-lockfile \
      --filter "todo-app-api-nestjs..." \
      --filter "@todo-app/db..."

# ---- build: core (tsc) -> prisma generate -> nest build ----
FROM deps AS build
COPY packages/core packages/core
COPY packages/db   packages/db
COPY apps/api      apps/api
RUN pnpm --filter @todo-app/core build \
 && pnpm --filter @todo-app/db run db:generate \
 && pnpm --filter todo-app-api-nestjs build

# ---- runtime: the API (the migrate service reuses this image) ----
FROM build AS runtime
ENV NODE_ENV=production
WORKDIR /app/apps/api
EXPOSE 3000
CMD ["node", "dist/main.js"]
