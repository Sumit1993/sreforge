ALERT=BooklogrApiLatencyP99High
DELIVERY_MODE=arm-deploy-recent
BASELINE_REF=scenario/cascading-upstream-failure
ANCHOR_BASE_REF=baseline^        # TUNE-ON-CERT — verify the anchor's healthy state already contains the baseline index migration
FAULT_PATCH=use-cases/booklogr/scenarios/cascading-upstream-failure/inject/fault.patch
COMMIT_MESSAGE="Schema cleanup: drop unused books title index"
AUTHOR_NAME="Andreas Backström"
AUTHOR_EMAIL="mozzo242@gmail.com"
STORM_SCRIPT=booklogr-storm-shelf.js
RATE=50                              # TUNE-ON-CERT
SEED_COUNT=300000                    # TUNE-ON-CERT
FIX_MESSAGE="Restore books owner/title index"
READINESS_GATE=on
