# scenario.env — db-pool-exhaustion-deploy (mode 2: arm-deploy-recent)
SCENARIO_ID=db-pool-exhaustion-deploy
ALERT=BooklogrApiLatencyP99High
DELIVERY_MODE=arm-deploy-recent
BASELINE_REF=scenario/db-pool-exhaustion-deploy
ANCHOR_BASE_REF=baseline^
FAULT_PATCH=use-cases/booklogr/scenarios/db-pool-exhaustion-deploy/inject/fault.patch
COMMIT_MESSAGE="Reduce DB connection footprint"
AUTHOR_NAME="Andreas Backström"
AUTHOR_EMAIL="mozzo242@gmail.com"
STORM_SCRIPT=booklogr-storm-mixed.js
RATE=25
SEED_COUNT=150000
FIX_MESSAGE="Restore DB connection pool sizing"
# Like decoy-deploy-control, this scenario's storm never lets up once armed, so a
# fix's redeploy racing the full-rate storm the instant its port is published can
# chronically fail its own healthcheck before the oracle ever gets to grade
# alert_cleared (see run-incident.mjs's ComposeCdDeployer wiring). Opt into the
# readiness-gated rollout so the swap drains the storm, waits for healthy, then
# resumes under still-active load (ADR-0004 is preserved — grading still happens
# under active load, just not during the cold-start race).
READINESS_GATE=on
