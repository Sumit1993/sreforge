# scenario.env — decoy-deploy-control (mode 3: arm-runtime-notrace)
SCENARIO_ID=decoy-deploy-control
ALERT=BooklogrApiLatencyP99High
DELIVERY_MODE=arm-runtime-notrace
BASELINE_REF=scenario/decoy-deploy-control
ANCHOR_BASE_REF=baseline^
FAULT_PATCH=use-cases/booklogr/scenarios/decoy-deploy-control/inject/fault.patch
COMMIT_MESSAGE="Fix invalid HTTP status in settings response"
AUTHOR_NAME="Andreas Backström"
AUTHOR_EMAIL="mozzo242@gmail.com"
RUNTIME_ENV_VAR=CACHE_TYPE
RUNTIME_ENV_VALUE=NullCache
STORM_SCRIPT=booklogr-storm.js
RATE=25
FIX_MESSAGE="Pin response cache backend to SimpleCache"
