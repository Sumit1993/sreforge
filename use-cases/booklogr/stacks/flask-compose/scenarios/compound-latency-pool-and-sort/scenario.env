# scenario.env — compound-latency-pool-and-sort (mode: arm-deploy-recent-compound)
SCENARIO_ID=compound-latency-pool-and-sort
ALERT=BooklogrApiLatencyP99High
DELIVERY_MODE=arm-deploy-recent-compound
BASELINE_REF=scenario/compound-latency-pool-and-sort
ANCHOR_BASE_REF=baseline^

# --- Ordered compound commits (index 1 = oldest, applied first) ---
# Commit 1 — CONFIG/RUNTIME layer (db-pool fault), backdated ~6 days.
FAULT_PATCH_1=use-cases/booklogr/scenarios/compound-latency-pool-and-sort/inject/fault-1-config.patch
COMMIT_MESSAGE_1="Reduce DB connection footprint"
AUTHOR_NAME_1="Andreas Backström"
AUTHOR_EMAIL_1="mozzo242@gmail.com"
COMMIT_DATE_1="6 days ago"          # git-parseable; MUST be after anchor parent, before commit 2

# Commit 2 — APPLICATION-CODE layer (worker-cpu fault), real current timestamp (the "recent deploy").
FAULT_PATCH_2=use-cases/booklogr/scenarios/compound-latency-pool-and-sort/inject/fault-2-sort.patch
COMMIT_MESSAGE_2="Order library list by shelf position"
AUTHOR_NAME_2="Tomás Rivera"
AUTHOR_EMAIL_2="trivera.dev@gmail.com"
COMMIT_DATE_2="now"                 # real timestamp; leave empty/"now" to use current time

# --- Storm & seeding ---
STORM_SCRIPT=booklogr-storm-mixed.js   # pure library-list; book-metadata NOT exercised
RATE=50                                # TUNE-ON-CERT: both solo p99 must keep headroom over 0.3s
SEED_COUNT=150000

# --- Relentless fault: readiness-gated rollout (gotcha #2, mandatory) ---
READINESS_GATE=on

# --- Fix (reverts BOTH commits) ---
FIX_MESSAGE="Restore DB connection pool sizing and database-side pagination"
