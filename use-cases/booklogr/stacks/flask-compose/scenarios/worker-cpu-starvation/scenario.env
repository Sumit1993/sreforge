# scenario.env — worker-cpu-starvation (mode 2: arm-deploy-recent)
SCENARIO_ID=worker-cpu-starvation
ALERT=BooklogrApiLatencyP99High
DELIVERY_MODE=arm-deploy-recent
BASELINE_REF=scenario/worker-cpu-starvation
ANCHOR_BASE_REF=baseline^
FAULT_PATCH=use-cases/booklogr/scenarios/worker-cpu-starvation/inject/fault.patch
COMMIT_MESSAGE="Order library list by shelf position"
AUTHOR_NAME="Tomás Rivera"
AUTHOR_EMAIL="trivera.dev@gmail.com"
STORM_SCRIPT=booklogr-storm-browse-mixed.js
RATE=50
SEED_COUNT=150000
FIX_MESSAGE="Restore database-side pagination for the library list"

# --- storm-capture opt-in (multi-alert storm scenario) -------------------------
# Capture the alert storm within a short window of the primary alert so the
# grouping/correlation surface (booklogr-api latency + book-metadata traffic
# collapse) is delivered together at t0.
WEBHOOK_STORM_WINDOW_S=30
# Symptom-level operator chatter delivered in the t0 bundle (passes the t0-bundle
# assertSymptomLevel guard — no root-cause words).
TRIAGE_FEED=use-cases/booklogr/scenarios/worker-cpu-starvation/inject/triage.jsonl

# The browse-mixed storm's low-rate book-detail trickle (the book-metadata
# coupling) uses the script defaults (RATE_META=1 per META_UNIT=3s ~= 0.33 req/s,
# well under 1% of RATE so it does not move the healthy-baseline p99). Override
# here if certification tuning needs it.  # TUNE-ON-CERT

# Like db-pool-exhaustion-deploy, this scenario's storm never lets up once armed, so a
# fix's redeploy racing the full-rate storm the instant its port is published can
# chronically fail its own healthcheck before the oracle ever gets to grade
# alert_cleared. Opt into the readiness-gated rollout so the swap drains the storm,
# waits for healthy, then resumes under still-active load (ADR-0004 is preserved —
# grading still happens under active load, just not during the cold-start race).
READINESS_GATE=on
