{
  "network": {
    "allowedDomains": [
      "*.googleapis.com",
      "*.google.com",
      "*.codeium.com",
      "*.windsurf.com",
      "*.antigravity.google"
    ],
    "deniedDomains": [],
    "allowUnixSockets": ["/var/run/docker.sock", "/run/docker.sock"],
