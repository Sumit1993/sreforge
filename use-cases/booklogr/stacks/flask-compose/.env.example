# Copy to .env and adjust. Consumed by docker compose (app stack + forge).
# Real .env is gitignored.

# --- Substrate import (scripts/import-substrate.sh) ---
UPSTREAM_REPO=https://github.com/Mozzo1000/booklogr.git
GITEA_URL=http://localhost:3000
GITEA_ADMIN_USER=sreforge
GITEA_ADMIN_PASSWORD=change-me-locally
GITEA_ADMIN_EMAIL=admin@localhost
# Org/repo the substrate is imported into (the run workspace's origin).
GITEA_REPO_OWNER=booklogr
GITEA_REPO_NAME=booklogr

# --- act_runner registration (filled after generating a token) ---
GITEA_RUNNER_REGISTRATION_TOKEN=

# --- booklogr app deployment (compose/docker-compose.yml) ---
AUTH_DEFAULT_USER=demo@booklogr.app
AUTH_DEFAULT_PASSWORD=demo
# M2 repoints these at the deterministic slow-upstream stub.
DATA_PROVIDER=openlibrary
DATA_PROVIDER_FALLBACK=https://metadata.booklogr.app
