# The imported substrate checkout (populated by scripts/import-substrate.sh).
# It is held in the local Gitea forge, never committed into the harness repo
# (physical harness/substrate separation, D12).
substrate/

# Local secrets + runner token.
.env

# Compose-managed local state (if any binds land here).
gitea-data/
act-runner-data/

# Per-run records written by the conductor driver (run-incident.mjs) — ephemeral
# run artifacts (record.json / diff.patch / transcript.txt), regenerated each run.
runs/

# clean per-run agent workspace (de-tell'd clone, regenerated each run)
.run-workspace/
