#!/bin/sh
# =============================================================================
# submit — the agent's completion handoff (the concrete SUBMIT_CMD).
#
# WHAT THIS IS
#   The on-PATH command the EXTERNAL SRE agent runs inside agent-shell, from
#   /workspace, once it believes its edit resolves the incident. It is a
#   HANDOFF, never a push: it makes the agent's edits visible to the host
#   orchestration engine PURELY through the bind-mounted /workspace (= host
#   .run-workspace/booklogr), then signals completion. The engine (outside the
#   sandbox) watches /workspace, captures the diff, and owns the forge push / PR
#   / CI. There is therefore NO forge here, NO push, NO network back to the
#   engine — only writes to /workspace.
#
# WHAT IT DOES, AND ONLY ON THE SHARED MOUNT
#   1. git add -A                         (stage every edit: adds/deletes/renames)
#   2. if anything is staged, commit it onto a local `submission` branch under a
#      neutral identity — purely so HEAD captures the edits for the engine to
#      diff. (An empty edit set skips the commit; the sentinel is still written,
#      and the engine will see an empty diff = no fix produced.)
#   3. write the sentinel /workspace/.sreforge/submit.json
#        { "submittedAt": <ISO8601>, "headSha": <HEAD sha>, "note": <message> }
#      ATOMICALLY (temp file + rename) so the host never reads a half-written
#      file. A second invocation overwrites it — latest submission wins.
#   4. print a neutral confirmation and exit 0.
#
# DE-TELL / BOUNDARY POSTURE
#   No forge env, no token, no remote, no network. The .sreforge/ sentinel dir
#   is engine-private metadata; the engine excludes it from the diff it replays
#   onto the substrate, so it never reaches the forge history. This keeps the
#   boundary verify-boundary.sh asserts intact (the shim adds no route/credential).
#
# DEPENDENCY-LIGHT
#   POSIX sh + busybox/alpine: only git, date, and standard shell builtins.
#
# USAGE (inside agent-shell, cwd /workspace)
#   submit                       # submit the current edits
#   submit "raised cache TTL"    # submit with an optional note
# =============================================================================
set -eu

# The bind-mounted workspace is the agent's whole edit surface AND the only
# channel to the engine. Default to /workspace (the mount), overridable for
# tests via WORKSPACE.
WORKSPACE="${WORKSPACE:-/workspace}"

RCA_PATH=""
if [ "${1:-}" = "--rca" ]; then
  if [ $# -ge 2 ] && [ -n "$2" ]; then
    RCA_PATH="$2"
    shift 2
  else
    echo "submit: warning — --rca given without a path, ignoring" >&2
    if [ $# -ge 2 ]; then shift 2; else shift 1; fi
  fi
fi
NOTE="${1:-}"

if [ ! -d "$WORKSPACE/.git" ]; then
  echo "submit: no git workspace at $WORKSPACE (.git missing)" >&2
  exit 1
fi

# Neutral identity for the local capture commit. The engine RE-commits the
# applied diff under project authorship on the forge substrate, so this identity
# never reaches the forge — it only makes the local HEAD a stable diff anchor.
SUBMIT_NAME="${SUBMIT_AUTHOR_NAME:-agent}"
SUBMIT_EMAIL="${SUBMIT_AUTHOR_EMAIL:-agent@localhost}"

# 1. Put the edits on a local `submission` branch at the current HEAD, so the
#    capture commit never disturbs the checked-out default branch's identity.
#    -B is idempotent: a second submit re-points the branch at HEAD.
git -C "$WORKSPACE" checkout -B submission >/dev/null 2>&1

# 2. Stage everything (adds, deletes, renames, modes).
git -C "$WORKSPACE" add -A

# 3. Commit only if there is something staged. An empty edit set is allowed —
#    the engine then sees an empty diff and records a no-fix run (correct).
if ! git -C "$WORKSPACE" diff --cached --quiet; then
  git -C "$WORKSPACE" \
    -c "user.name=$SUBMIT_NAME" \
    -c "user.email=$SUBMIT_EMAIL" \
    commit -q -m "submission" >/dev/null
  COMMITTED=1
else
  COMMITTED=0
fi

HEAD_SHA="$(git -C "$WORKSPACE" rev-parse HEAD 2>/dev/null || echo "")"
SUBMITTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# 4. Write the sentinel atomically. Escape the note for JSON (backslashes and
#    double quotes only — busybox sed handles both; control chars are unlikely
#    from an agent message and would be the agent's own problem to avoid).
escape_json() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}
NOTE_ESCAPED="$(escape_json "$NOTE")"

SENTINEL_DIR="$WORKSPACE/.sreforge"
SENTINEL="$SENTINEL_DIR/submit.json"
mkdir -p "$SENTINEL_DIR"

if [ -n "$RCA_PATH" ]; then
  CANONICAL_WORKSPACE="$(readlink -f "$WORKSPACE" 2>/dev/null || realpath "$WORKSPACE")"
  CANONICAL_RCA="$(readlink -f "$RCA_PATH" 2>/dev/null || realpath "$RCA_PATH" 2>/dev/null || echo "")"
  
  case "$CANONICAL_RCA" in
    "$CANONICAL_WORKSPACE/"*)
      if [ -s "$CANONICAL_RCA" ]; then
        cp "$CANONICAL_RCA" "$WORKSPACE/.sreforge/rca.txt.tmp" && mv "$WORKSPACE/.sreforge/rca.txt.tmp" "$WORKSPACE/.sreforge/rca.txt" || {
          echo "submit: warning — RCA copy failed, continuing without RCA" >&2
          rm -f "$WORKSPACE/.sreforge/rca.txt.tmp"
        }
      else
        echo "submit: warning: --rca $RCA_PATH is missing or empty" >&2
      fi
      ;;
    *)
      echo "submit: warning — RCA path outside workspace, ignoring" >&2
      ;;
  esac
fi

TMP="$SENTINEL_DIR/.submit.json.tmp.$$"
printf '{"submittedAt":"%s","headSha":"%s","note":"%s"}\n' \
  "$SUBMITTED_AT" "$HEAD_SHA" "$NOTE_ESCAPED" >"$TMP"
mv -f "$TMP" "$SENTINEL"

# 5. Neutral confirmation. No harness/eval vocabulary, no forge mention.
if [ "$COMMITTED" -eq 1 ]; then
  echo "Submitted. Your change has been handed off for review."
else
  echo "Submitted. No changes were detected in the workspace."
fi
exit 0
