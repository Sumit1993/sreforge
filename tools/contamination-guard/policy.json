{
  "$comment": "Contamination policy for SREForge substrate repos. Enforces D8 (de-tell) + D12 (physical separation) programmatically. Patterns are JS regex source (escaped for JSON); all matching is case-insensitive and global. Tune per-stack by copying this file and passing --policy. See README.md.",

  "hardTells": [
    { "id": "bug-marker",          "pattern": "\\bBUG\\s*#\\s*\\d+",                                                   "message": "Planted-bug marker. Real code never labels its own bugs by number." },
    { "id": "sreforge",            "pattern": "\\bsreforge\\b",                                                       "message": "Harness name leaked into substrate." },
    { "id": "harness-vocab",       "pattern": "\\bharness\\b",                                                        "message": "Harness vocabulary in agent-visible code." },
    { "id": "de-tell",             "pattern": "\\bde-?tell(?:ing|ed)?\\b",                                            "message": "Reveals the de-tell process itself." },
    { "id": "contamination",       "pattern": "\\bcontaminat(?:ion|ed|e|ing)\\b",                                     "message": "Reveals the contamination-control intent." },
    { "id": "cover-story",         "pattern": "\\bcover[- ]?story\\b",                                                "message": "Reveals the cover story." },
    { "id": "scenario-name",       "pattern": "\\b(?:latency[- ]?)?retry[- ]?storm\\b",                               "message": "Scenario name (latency-retry-storm) leaked." },
    { "id": "oracle-script",       "pattern": "\\b(?:confirm[- ]?fire|verify[- ]?clear)\\b",                          "message": "Harness oracle script name leaked." },
    { "id": "planted",             "pattern": "\\bplanted\\s+(?:bug|fault|error|issue|defect)s?\\b",                  "message": "Admits a planted defect." },
    { "id": "fault-injection",     "pattern": "\\bfault[- ]?inject(?:ion|ed|ing)?\\b",                               "message": "Fault-injection vocabulary." },
    { "id": "injection-confession","pattern": "\\b(?:sed|manual|mechanical|automated)[- ]?based?\\s*injection\\b",   "message": "Admits the bug was mechanically injected." },
    { "id": "inject-the-bug",      "pattern": "\\binject(?:ed|ing)\\s+(?:the\\s+|a\\s+)?(?:bug|fault|error|latency|defect|validationpipe)\\b", "message": "Describes injecting a defect." },
    { "id": "sim-incident",        "pattern": "\\bincident\\s+simulation\\b",                                         "message": "'Incident simulation' announces the rig." },
    { "id": "sim-dashboard",       "pattern": "\\bsimulation\\s+dashboard\\b",                                        "message": "Harness control panel disguised as a feature." },
    { "id": "sim-typed",           "pattern": "\\b(?:error|latency|memory[- ]?leak)\\s+simulation\\b",                "message": "Typed simulation feature reveals the rig." },
    { "id": "simulate-incidents",  "pattern": "\\bsimulate\\s+(?:real[- ]?world\\s+)?incidents?\\b",                  "message": "Describes simulating incidents." },
    { "id": "testing-workspace",   "pattern": "\\btesting\\s+(?:incident\\s+response|workspace|observability)\\b",    "message": "Frames the app as a testing workspace, not a product." },
    { "id": "trigger-alerts",      "pattern": "\\btrigger(?:ing|s)?\\s+(?:realistic\\s+|prometheus\\s+|rate[- ]?based\\s+|monitoring\\s+)?alerts?\\b", "message": "Describes deliberately triggering alerts." },
    { "id": "eval-harness",        "pattern": "\\b(?:evaluation|eval)\\s+harness\\b",                                 "message": "Reveals the evaluation harness." },
    { "id": "sreforge-dep",        "pattern": "@sreforge/",                                                           "message": "Substrate depends on a harness package." }
  ],

  "softTells": [
    { "id": "fixme",        "pattern": "\\bFIXME\\b",                       "message": "FIXME — review whether it hints at a known planted issue." },
    { "id": "xxx-marker",   "pattern": "\\bXXX\\b",                         "message": "XXX marker — review for tell." },
    { "id": "hack-comment", "pattern": "\\bHACK\\b",                        "message": "HACK marker — review for tell." },
    { "id": "bare-oracle",  "pattern": "\\boracle\\b",                      "message": "'oracle' — legit only if it means Oracle DB; else a verify-oracle leak." },
    { "id": "bare-inject",  "pattern": "\\binject(?:ed|ing|ion)\\b",        "message": "'inject' outside NestJS DI (@Injectable is fine) — review context." },
    { "id": "bare-fault",   "pattern": "\\bfault\\b",                       "message": "'fault' as a whole word (not 'default') — review for fault-injection intent." },
    { "id": "bare-scenario","pattern": "\\bscenario\\b",                    "message": "'scenario' — 'error scenarios' is fine; a harness scenario ref is not." }
  ],

  "forbiddenDirs": [".claude", "load", "scenarios", "solution"],

  "forbiddenFiles": [
    "settings.local.json",
    "driver.mjs",
    "load-test.js",
    "confirm-fire.mjs",
    "verify-clear.mjs",
    "incident.sh",
    "scenario.toml",
    "trigger.md",
    "oracle.md",
    "fix.patch",
    "reference-fix.md"
  ],

  "ignoreDirs": ["node_modules", ".git", ".next", "dist", "build", "out", "coverage", ".turbo", ".cache", "__snapshots__"],
  "ignoreFiles": ["pnpm-lock.yaml", "package-lock.json", "yarn.lock"],
  "ignoreExtensions": [".lock", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".ico", ".webp", ".woff", ".woff2", ".ttf", ".eot", ".map", ".pdf", ".zip", ".gz"],

  "$allowList": "Regexes here exempt a matching line from ALL rules. Use sparingly for genuine false positives a real product would contain.",
  "allowList": []
}
