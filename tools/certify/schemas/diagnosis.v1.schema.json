{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreforge.dev/schemas/diagnosis.v1.json",
  "title": "SREForge RCA Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "scenario", "score", "axes",
    "rationale", "rubric_version", "judge_model", "judged_at"
  ],
  "properties": {
    "schema_version": { "const": "diagnosis.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause_correct", "evidence_grounded", "false_leads"],
      "properties": {
        "root_cause_correct": { "type": "boolean" },
        "evidence_grounded": { "type": "boolean" },
        "false_leads": { "type": "boolean" }
      }
    },
    "rationale": { "type": "string" },
    "rubric_version": { "type": "string", "minLength": 1 },
    "judge_model": { "type": "string", "minLength": 1 },
    "judged_at": { "type": "string", "minLength": 1 }
  }
}
