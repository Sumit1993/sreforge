{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreforge.dev/schemas/scenario-certification.v1.json",
  "title": "SREForge scenario certification manifest (ADR-0026)",
  "description": "Per-scenario evidence that the full acceptance practice ran, hash-tied to the scenario's own + shared surface. Lives at use-cases/<uc>/scenarios/<id>/verify/acceptance.json. CI validates this offline; the operator's machine produces it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "kind", "use_case", "stack", "scenario", "hashes", "tier", "checklist", "records"],
  "properties": {
    "manifest_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "scenario-certification" },
    "use_case": { "type": "string", "minLength": 1 },
    "stack": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "certified_at": { "type": "string", "minLength": 1 },
    "certified_commit": { "type": "string" },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "own_hash", "shared_hash"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "own_hash": { "$ref": "#/$defs/sha256" },
        "shared_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "description": "Additive per-scenario surface beyond convention/global-default (ADR-0026 §2). Stack-relative paths.",
      "properties": {
        "own_additions": { "type": "array", "items": { "type": "string" } },
        "shared_additions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tier": { "const": "agent-certified" },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "description": "ADR-0026 §5 certification checklist outcomes.",
      "required": ["structure_lint", "contamination_guard", "detell", "determinism", "solvability", "anti_cheat", "regression"],
      "properties": {
        "structure_lint": { "$ref": "#/$defs/check" },
        "contamination_guard": { "$ref": "#/$defs/check" },
        "detell": {
          "type": "object",
          "additionalProperties": false,
          "description": "De-tell sweep + rig-only judge on the scenario's NEW agent-visible surface, judged by an independent model (ADR-0026 §5).",
          "required": ["status", "model"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "model": { "type": "string", "minLength": 1 },
            "evidence": { "type": "string" }
          }
        },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "description": "ADR-0026 §5: 10-min healthy-quiet soak + 2 consecutive cold arms firing in budget, fire times recorded.",
          "required": ["status", "soak_minutes", "cold_arms", "fire_times_seconds"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "soak_minutes": { "type": "number", "minimum": 10 },
            "cold_arms": { "type": "integer", "minimum": 2 },
            "fire_times_seconds": { "type": "array", "minItems": 2, "items": { "type": "number" } },
            "evidence": { "type": "string" }
          }
        },
        "solvability": { "$ref": "#/$defs/check" },
        "anti_cheat": { "$ref": "#/$defs/check" },
        "regression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ran"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "ran": { "type": "boolean" },
            "evidence": { "type": "string" }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "description": "≥1 graded agent attempt (ADR-0026 §3): attempt recorded, pass OR fail. shared_hash addenda are appended as kind=positive-smoke.",
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "graded" } }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "driver", "session", "outcome", "at", "full_record_sha256", "run_url"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["graded", "positive-smoke"] },
          "driver": { "type": "string", "minLength": 1 },
          "session": { "enum": ["cold", "warm"] },
          "outcome": { "enum": ["pass", "fail"] },
          "score": { "type": ["number", "null"] },
          "at": { "type": "string", "minLength": 1 },
          "full_record_sha256": { "$ref": "#/$defs/sha256" },
          "run_url": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["pass", "fail", "skip"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "model": { "type": "string" },
        "evidence": { "type": "string" }
      }
    }
  }
}
