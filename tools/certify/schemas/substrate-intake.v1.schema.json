{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreforge.dev/schemas/substrate-intake.v1.json",
  "title": "SREForge substrate-intake manifest (ADR-0026)",
  "description": "Per-use-case, once: formalizes the M0 intake gate (ADR-0014) — contamination guard, full 3-axis de-tell judge, fault surface, compose confirmed. Lives at use-cases/<uc>/verify/intake.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "kind", "use_case", "stack", "contamination_guard", "detell_judge", "fault_surface", "compose_confirmed"],
  "properties": {
    "manifest_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "substrate-intake" },
    "use_case": { "type": "string", "minLength": 1 },
    "stack": { "type": "string", "minLength": 1 },
    "intake_at": { "type": "string" },
    "intake_commit": { "type": "string" },
    "contamination_guard": { "$ref": "#/$defs/check" },
    "detell_judge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Full 3-axis de-tell judge (intake-level; ADR-0014/ADR-0026 §1), judged by an independent model.",
      "required": ["status", "model", "axes"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "model": { "type": "string", "minLength": 1 },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["staged_rig", "recognizability", "memorization"],
          "properties": {
            "staged_rig": { "$ref": "#/$defs/axis" },
            "recognizability": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score"],
              "properties": {
                "score": { "type": "integer" },
                "recognized_as": { "type": "string" },
                "notes": { "type": "string" }
              }
            },
            "memorization": { "$ref": "#/$defs/axis" }
          }
        }
      }
    },
    "fault_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "description": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "compose_confirmed": { "$ref": "#/$defs/check" }
  },
  "$defs": {
    "status": { "enum": ["pass", "fail", "skip", "confirmed"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "string" }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score"],
      "properties": {
        "score": { "type": "integer" },
        "notes": { "type": "string" }
      }
    }
  }
}
