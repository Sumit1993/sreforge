NODE_ENV=development

# Server
API_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://todo:todopass@localhost:5432/tododb

# Cache (Valkey — Redis-compatible)
REDIS_URL=redis://localhost:6379

# Metrics
METRICS_PROVIDER=local
# LOCAL_PUSHGATEWAY_URL=http://localhost:9091/metrics/job/todo-api

# Optional: Grafana Cloud log shipping
# GRAFANA_LOKI_URL=https://logs-prod-xx-xxx.grafana.net/loki/api/v1/push
# GRAFANA_API_KEY=your-grafana-api-key
