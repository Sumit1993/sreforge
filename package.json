{
  "name": "todo-app-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy:k8s": "turbo run deploy:k8s",
    "deploy:vm": "turbo run deploy:vm",
    "deploy:firebase": "turbo run deploy:firebase",
    "deploy:supabase": "turbo run deploy:supabase",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "infra:up": "docker compose -f infra/docker/dev/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/dev/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "@swc/core",
      "sharp"
    ]
  }
}
